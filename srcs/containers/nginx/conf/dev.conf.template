server {
    listen 80;
    listen [::]:80;
    server_name _;

    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name _;

    set $csp "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    include /etc/nginx/snippets/app.conf;

    location / {
        proxy_pass http://front:5173;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
