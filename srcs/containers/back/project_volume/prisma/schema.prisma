datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model Player {
  id                Int         @id @default(autoincrement())
  name              String      @unique
  email             String?     @unique
  password          String
  isGuest           Boolean     @default(false) @map("is_guest")
  aboutMe           String?     @map("about_me")
  avatarUrl			String?		@map("avatar_url")
  isAdmin           Boolean     @default(false) @map("is_admin")
  createdAt         DateTime    @default(now()) @map("created_at")
  deletedAt         DateTime?   @map("deleted_at")

  rooms                   Rooms[]
  gamePlayers             Game_Players[]
  sentFriendRequests      Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests  Friendship[] @relation("FriendshipAddressee")
}

model Rooms {
  id                Int       @id @default(autoincrement())
  name              String
  minPlayers        Int       @default(3) @map("min_players")
  maxPlayers        Int       @default(6) @map("max_players")
  colyseusRoomId    String?   @map("colyseus_room_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  createdBy         Int       @map("created_by")
  createdByRel      Player    @relation(fields: [createdBy], references: [id])

  games             Games[]
}

enum GameStatus {
  waiting
  playing
  finished
}

enum Role {
  civilian
  undercover
}

model Games {
  id                Int         @id @default(autoincrement())
  status            GameStatus  @default(waiting)
  civilianWord      String      @map("civilian_word")
  undercoverWord    String      @map("undercover_word")
  createdAt         DateTime    @default(now()) @map("created_at")
  finishedAt        DateTime?   @map("finished_at")
  victory           Role?

  roomId            Int         @map("room_id")
  roomIdRel         Rooms       @relation(fields: [roomId], references: [id])

  gamePlayers       Game_Players[]
}

model Game_Players {
  id                Int         @id @default(autoincrement())
  role              Role
  eliminatedAt      DateTime?   @map("eliminated_at")

  gameId            Int         @map("game_id")
  gameIdRel         Games       @relation(fields: [gameId], references: [id])

  playerId          Int         @map("player_id")
  playerIdRel       Player      @relation(fields: [playerId], references: [id])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Friendship {
  id          Int              @id @default(autoincrement())
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requesterId Int    @map("requester_id")
  requester   Player @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId Int    @map("addressee_id")
  addressee   Player @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Word_Pair {
  id                Int         @id @default(autoincrement())
  civilianWord      String      @map("civilian_word")
  undercoverWord    String      @map("undercover_word")
  civilianWordFr    String      @map("civilian_word_fr")
  undercoverWordFr  String      @map("undercover_word_fr")
  civilianWordEs    String      @map("civilian_word_es")
  undercoverWordEs  String      @map("undercover_word_es")
}
